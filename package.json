{
  "name": "stoatworks-flasher",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Flash Stoatworks firmware, or any ESP32 image, from a browser tab over USB: no toolchain, nothing uploaded.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "import-firmware": "node scripts/import-firmware.ts",
    "predev": "node scripts/downloads.ts",
    "prebuild": "node scripts/downloads.ts",
    "export-release": "node scripts/export-release.ts"
  },
  "dependencies": {
    "esptool-js": "^0.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/w3c-web-serial": "^1.0.9",
    "fflate": "0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
